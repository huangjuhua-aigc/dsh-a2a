# The published dsh family peer-depends on siblings that are NOT all on npm
# (dsh-compact, dsh-type-meta, dsh-util are absent as of 0.1.0-rc.6). Auto-installing
# peers therefore fails the whole graph. We declare exactly the packages we import
# and let the rest stay unsatisfied warnings.
auto-install-peers=false
strict-peer-dependencies=false

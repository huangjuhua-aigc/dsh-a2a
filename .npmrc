# auto-install-peers matches how pnpm-lock.yaml is produced (settings.autoInstallPeers: true),
# so `pnpm install --frozen-lockfile` works without extra flags. The dsh 0.2.1-rc.2 dev/test
# graph (agent loop, testkit, credentials-local, ...) relies on auto-installed peers; turning
# this off drops them and breaks 9 test files. Peers that are genuinely unpublished stay
# warnings because strict-peer-dependencies is off.
auto-install-peers=true
strict-peer-dependencies=false
